FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=sqlite:///./scriptforge.db

# Model Provider settings: "vertex" or "ollama"
MODEL_PROVIDER=ollama

# Vertex AI Gemini
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-pro

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Stock video APIs
PEXELS_API_KEY=
PIXABAY_API_KEY=

# NVIDIA Riva/Magpie TTS
NVIDIA_API_KEY=

# Background music
MUSIC_ENABLED=true
